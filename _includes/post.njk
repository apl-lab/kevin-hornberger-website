---
layout: base.njk
---
<section class="page-hero">
  <div class="container">
    <div class="kicker">News &amp; Updates</div>
    <h1>{{ title }}</h1>
    <div class="post-meta">{{ date | dateDisplay }}{% if type and type != "original" %} &middot; {{ type }}{% endif %}</div>
  </div>
</section>
<main>
  <div class="container prose">
    {{ content | safe }}
    <a class="back-link" href="/news/">&larr; Back to all news</a>
  </div>
</main>
